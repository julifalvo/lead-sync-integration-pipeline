# Copy this file to .env and adjust if needed. Defaults already work with docker-compose up.

# Postgres
POSTGRES_USER=integration
POSTGRES_PASSWORD=integration
POSTGRES_DB=integration_db
POSTGRES_DSN=postgresql://integration:integration@postgres:5432/integration_db

# RabbitMQ (AMQP broker + management UI on :15672, same credentials)
RABBITMQ_USER=integration
RABBITMQ_PASSWORD=integration
RABBITMQ_URL=amqp://integration:integration@rabbitmq:5672/%2F
RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672
EXCHANGE_NAME=leads.topic
QUEUE_NAME=leads.queue
DLX_NAME=leads.dlx
DLQ_NAME=leads.dlq
ROUTING_KEY=lead.created

# Shared secret used to HMAC-SHA256 sign/verify webhook payloads
# (the generator script and curl examples use this to sign requests)
WEBHOOK_SIGNING_SECRET=dev-local-signing-secret

# Simulated CRM flakiness, used to exercise the retry/backoff -> DLQ logic (0.0 - 1.0)
CRM_FAILURE_RATE=0.15

# Prometheus scrapes the worker's metrics server on this port
WORKER_METRICS_PORT=9100

LOG_LEVEL=INFO
