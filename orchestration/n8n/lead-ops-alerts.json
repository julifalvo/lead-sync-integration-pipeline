{
  "name": "Lead Sync - DLQ Watchdog",
  "nodes": [
    {
      "id": "schedule-trigger",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 5 }] }
      }
    },
    {
      "id": "check-dlq",
      "name": "Check leads.dlq depth",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0],
      "parameters": {
        "url": "http://rabbitmq:15672/api/queues/%2F/leads.dlq",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "options": {}
      },
      "credentials": {
        "httpBasicAuth": { "id": "rabbitmq-management", "name": "RabbitMQ management (integration/integration)" }
      }
    },
    {
      "id": "has-messages",
      "name": "messages > 0?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [520, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.messages }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "alert-ops",
      "name": "Alert #integrations-oncall (swap for Slack/PagerDuty node)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [780, -80],
      "parameters": {}
    },
    {
      "id": "all-clear",
      "name": "DLQ empty, no-op",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [780, 80],
      "parameters": {}
    }
  ],
  "connections": {
    "Every 5 minutes": { "main": [[{ "node": "Check leads.dlq depth", "type": "main", "index": 0 }]] },
    "Check leads.dlq depth": { "main": [[{ "node": "messages > 0?", "type": "main", "index": 0 }]] },
    "messages > 0?": {
      "main": [
        [{ "node": "Alert #integrations-oncall (swap for Slack/PagerDuty node)", "type": "main", "index": 0 }],
        [{ "node": "DLQ empty, no-op", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
